<?xml version="1.0"?>

<robot name="wall1" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="mass" default="100.01" />
  <xacro:arg name="length" default="1.01" />
  <xacro:arg name="thickness" default="0.2" />
  <xacro:arg name="height" default="1.0" />
  <xacro:arg name="yaw" default="0.0" />
  <xacro:property name="namespace" value="$(arg namespace)" />
  <xacro:property name="mass" value="$(arg mass)" />
  <xacro:property name="length" value="$(arg length)" />
  <xacro:property name="thickness" value="$(arg thickness)" />
  <xacro:property name="height" value="$(arg height)" />
  <xacro:property name="yaw" value="$(arg yaw)" />

  <!-- Macro for the inertia of a box -->
  <xacro:macro name="box_inertia" params="x y z mass">
    <inertia ixx="${0.0833333 * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
      iyy="${0.0833333 * mass * (x*x + z*z)}" iyz="0.0"
      izz="${0.0833333 * mass * (x*x + y*y)}" />
  </xacro:macro>

    <!-- Macro for the inertial properties of a box -->
  <xacro:macro name="box_inertial" params="x y z mass *origin">
    <inertial>
      <mass value="${mass}" />
      <xacro:insert_block name="origin" />
      <xacro:box_inertia x="${x}" y="${y}" z="${z}" mass="${mass}" />
    </inertial>
  </xacro:macro>




<link name="${namespace}/wall">
  <xacro:box_inertial x="${length/2}" y="${thickness/2}" z="${height/2}" mass="${mass}">
    <origin xyz="0 0 0" />
  </xacro:box_inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 $(arg yaw)" />
    <geometry>
      <box size="${length} ${thickness} ${height}"/> 
    </geometry>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 $(arg yaw)" />
    <geometry>
      <box size="${length}  ${thickness} ${height}"/> 
     </geometry>
     <surface>
        <friction>
          <ode>
            <mu>5000</mu>
            <mu2>5000</mu2>
          </ode>
        </friction>
      </surface>
  </collision>
</link>
</robot>